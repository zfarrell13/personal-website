{
  "name": "zf-personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/ensure-tracks.ts && tsx scripts/build-worklets.ts && tsx scripts/copy-models.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/ensure-tracks.ts && tsx scripts/build-worklets.ts --production && tsx scripts/copy-models.ts",
    "build": "next build",
    "tracks": "tsx scripts/build-tracks.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dj/engine/worklets/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worklets": "tsx scripts/build-worklets.ts",
    "worklets:watch": "tsx scripts/build-worklets.ts --watch",
    "models": "tsx scripts/copy-models.ts"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "signalsmith-stretch": "1.3.2",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
